# Shared bench profile — every run_*.sh launches the engine through
#   synthigy exec -f "$HERE/bench.env" -- clj -M:... -m nrepl.cmdline --port N
# so this file, not the scripts, owns the bench-postgres connection and the
# encryption master key. Profile values win over the shell environment;
# per-run settings (SYNTHIGY_HOME, ports, audit flags) stay in
# each script. Every run starts from a wiped database, so the key below is a
# throwaway dev key, not a secret.

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=synthigy
POSTGRES_USER=bench
POSTGRES_PASSWORD=bench
POSTGRES_ADMIN_DB=postgres
POSTGRES_ADMIN_USER=bench
POSTGRES_ADMIN_PASSWORD=bench

SYNTHIGY_ID_FORMAT=xid
SYNTHIGY_LOG_SINKS=
SYNTHIGY_ENCRYPTION_MASTER_KEY=b64:sqtgn0UAX1N9Yt7lexkDSOIUBeX7S1tUqDftwIbsJXs=
