@workspace "Chat Rooms"

@search rooms
@description "Rooms the acting user may read, with members, administrators and
a member count. Which rooms come back is the room's read guard, not this query."
@namespace room
@watch
chat_room (order by name asc)
  xid
  name
  description
  _count
    members:members
  ->members (order by name asc)
    xid
    name
  ->administrators (order by name asc)
    xid
    name

@sql-template activity
@description "Per-room activity as the acting user sees it. Every user runs
this same SQL; the guards are injected into it, so each gets their own numbers."
@namespace room
@watch chat_message, chat_room
@returns room:string, messages:int, authors:int, last_post:string?
SELECT {chat_message->chat_room.name} AS room,
       count(*) AS messages,
       count(DISTINCT {chat_message.author}) AS authors,
       max({chat_message.published_on}) AS last_post
FROM {chat_message}
GROUP BY 1
ORDER BY 1

@search list
@description "Messages of the given rooms the acting user may read, oldest
first. `-chat_room` keeps only messages whose room is in the list."
@namespace message
@watch
chat_message (order by published_on asc)
  xid
  content
  published_on
  ->author
    xid
    name
  -chat_room (xid in (?rooms:string[]))
    xid
    name

@batch overview: rooms activity
